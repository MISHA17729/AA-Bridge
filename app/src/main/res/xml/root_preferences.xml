<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="@string/pref_cat_video">
        <ListPreference
            android:key="car_orientation"
            android:title="@string/pref_car_orientation_title"
            android:summary="@string/pref_car_orientation_summary"
            android:entries="@array/car_orientation_entries"
            android:entryValues="@array/car_orientation_values"
            android:defaultValue="auto" />
        <ListPreference
            android:key="video_resolution_mode"
            android:title="@string/pref_resolution_mode_title"
            android:summary="@string/pref_resolution_mode_summary"
            android:entries="@array/resolution_mode_entries"
            android:entryValues="@array/resolution_mode_values"
            android:defaultValue="auto" />
        <EditTextPreference
            android:key="video_resolution_custom_width"
            android:title="@string/pref_custom_width_title"
            android:inputType="number" />
        <EditTextPreference
            android:key="video_resolution_custom_height"
            android:title="@string/pref_custom_height_title"
            android:inputType="number" />
        <ListPreference
            android:key="video_frame_rate"
            android:title="@string/pref_frame_rate_title"
            android:summary="@string/pref_frame_rate_summary"
            android:entries="@array/frame_rate_entries"
            android:entryValues="@array/frame_rate_values"
            android:defaultValue="30" />
        <EditTextPreference
            android:key="video_bitrate_kbps"
            android:title="@string/pref_bitrate_title"
            android:summary="@string/pref_bitrate_summary"
            android:inputType="number"
            android:defaultValue="4000" />
        <SwitchPreferenceCompat
            android:key="video_dpi_auto"
            android:title="@string/pref_dpi_auto_title"
            android:summary="@string/pref_dpi_auto_summary"
            android:defaultValue="true" />
        <EditTextPreference
            android:key="video_dpi_manual"
            android:title="@string/pref_dpi_manual_title"
            android:summary="@string/pref_dpi_manual_summary"
            android:inputType="number"
            android:defaultValue="160" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_cat_audio">
        <ListPreference
            android:key="audio_sample_rate"
            android:title="@string/pref_sample_rate_title"
            android:entries="@array/sample_rate_entries"
            android:entryValues="@array/sample_rate_values"
            android:defaultValue="48000" />
        <SwitchPreferenceCompat
            android:key="audio_stereo"
            android:title="@string/pref_audio_stereo_title"
            android:defaultValue="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_cat_aa">
        <Preference
            android:key="car_profiles"
            android:title="@string/pref_car_profiles_title"
            android:summary="@string/pref_car_profiles_summary" />
        <SwitchPreferenceCompat
            android:key="video_downscale_720p"
            android:title="@string/pref_downscale_title"
            android:summary="@string/pref_downscale_summary"
            android:defaultValue="true" />
        <ListPreference
            android:key="aa_fill_mode"
            android:title="@string/pref_fill_mode_title"
            android:summary="@string/pref_fill_mode_summary"
            android:entries="@array/aa_fill_mode_entries"
            android:entryValues="@array/aa_fill_mode_values"
            android:defaultValue="fit" />
        <ListPreference
            android:key="aa_audio_route"
            android:title="@string/pref_audio_route_title"
            android:summary="@string/pref_audio_route_summary"
            android:entries="@array/aa_audio_route_entries"
            android:entryValues="@array/aa_audio_route_values"
            android:defaultValue="phone_direct" />
        <SwitchPreferenceCompat
            android:key="aa_auto_crop"
            android:title="@string/pref_auto_crop_title"
            android:summary="@string/pref_auto_crop_summary"
            android:defaultValue="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_cat_connection">
        <ListPreference
            android:key="server_idle_timeout_min"
            android:title="@string/pref_idle_timeout_title"
            android:summary="@string/pref_idle_timeout_summary"
            android:entries="@array/server_idle_timeout_entries"
            android:entryValues="@array/server_idle_timeout_values"
            android:defaultValue="15" />
        <SwitchPreferenceCompat
            android:key="auto_reconnect_usb"
            android:title="@string/pref_auto_reconnect_title"
            android:summary="@string/pref_auto_reconnect_summary"
            android:defaultValue="true" />
        <ListPreference
            android:key="usb_role_override"
            android:title="@string/pref_usb_role_title"
            android:summary="@string/pref_usb_role_summary"
            android:entries="@array/usb_role_entries"
            android:entryValues="@array/usb_role_values"
            android:defaultValue="auto" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_cat_updates">
        <SwitchPreferenceCompat
            android:key="update_auto_check"
            android:title="@string/pref_update_auto_title"
            android:summary="@string/pref_update_auto_summary"
            android:defaultValue="true" />
        <Preference
            android:key="check_for_updates_now"
            android:title="@string/pref_update_now_title" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_cat_debug">
        <SwitchPreferenceCompat
            android:key="debug_verbose_logging"
            android:title="@string/pref_verbose_log_title"
            android:summary="@string/pref_verbose_log_summary"
            android:defaultValue="false" />
        <SwitchPreferenceCompat
            android:key="debug_overlay"
            android:title="@string/pref_debug_overlay_title"
            android:summary="@string/pref_debug_overlay_summary"
            android:defaultValue="false" />
        <SwitchPreferenceCompat
            android:key="auto_save_crash_log"
            android:title="@string/pref_crash_log_title"
            android:summary="@string/pref_crash_log_summary"
            android:defaultValue="true" />
        <Preference
            android:key="developer_tools"
            android:title="@string/pref_dev_tools_title"
            android:summary="@string/pref_dev_tools_summary" />
    </PreferenceCategory>

</androidx.preference.PreferenceScreen>
